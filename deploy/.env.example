# Copy to .env and fill in. Do NOT commit the real .env (it is gitignored).
#
# Generate the two secrets with:
#   docker run --rm gitea/gitea:1.22.6 gitea generate secret SECRET_KEY
#   docker run --rm gitea/gitea:1.22.6 gitea generate secret INTERNAL_TOKEN
# (or any 32+ char random string for SECRET_KEY; INTERNAL_TOKEN must be a Gitea-generated JWT)

# Public hostname Caddy terminates TLS for and Gitea advertises in clone URLs.
# Local prototype: use gitea.localhost (resolves to 127.0.0.1) with CADDY_TLS=internal.
GITEA_DOMAIN=gitea.localhost

# TLS mode — see Caddyfile. Email = public Let's Encrypt; "internal" = local CA for prototype.
CADDY_TLS=internal

# Host port mapped to Gitea's SSH. Clone URLs become ssh://git@GITEA_DOMAIN:GITEA_SSH_PORT/...
GITEA_SSH_PORT=2222

# Webhook egress allowlist for the future AI companion service (Phase 3).
# Comma-separated hosts/CIDRs. "*" is convenient locally; tighten for production.
GITEA_WEBHOOK_ALLOWED_HOSTS=*

# --- Secrets (replace the placeholders) ---
GITEA_SECRET_KEY=replace-with-generated-secret-key
GITEA_INTERNAL_TOKEN=replace-with-generated-internal-token

# Phase 2 — Actions runner registration token. Generate after Gitea is up with:
#   docker exec -u git codebase-gitea gitea actions generate-runner-token
RUNNER_REGISTRATION_TOKEN=replace-with-generated-runner-token

# --- Phase 3: AI companion service ---
# Scoped token for the codebase-ai-bot identity (scopes: write:issue,write:repository):
#   docker exec -u git codebase-gitea gitea admin user generate-access-token \
#     --username codebase-ai-bot --scopes write:issue,write:repository --token-name ai-service --raw
AI_BOT_TOKEN=replace-with-bot-access-token
# Shared HMAC secret between the Gitea webhook and the service:  openssl rand -hex 32
AI_WEBHOOK_SECRET=replace-with-hmac-secret
# PLACEHOLDER — the URL Gitea will POST events to. Internal default works for same-network
# delivery; change to a Caddy-exposed/public URL when the service moves. Used by
# scripts/register-webhook.sh (not auto-registered).
AI_WEBHOOK_TARGET_URL=http://ai-service:8080/gitea/events
